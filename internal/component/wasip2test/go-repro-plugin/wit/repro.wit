package test:repro;

/// Shared types used across interfaces.
interface types {
  /// A result record returned from handler exports.
  record process-result {
    value: u32,
    ok: bool,
  }

  /// Color enum for echo-enum test.
  enum color {
    red,
    green,
    blue,
  }

  /// Permissions flags for echo-flags test.
  flags permissions {
    read,
    write,
    execute,
  }

  /// Shape variant for echo-variant test.
  variant shape {
    circle(f64),
    square(f64),
    none,
  }

  /// A record with an option field, mirroring director's session-event.
  record event-data {
    event-type: color,
    metadata: option<list<u8>>,
  }

  /// A record containing a variant field.
  record tagged-shape {
    tag: string,
    shape: shape,
  }

  /// Deeply nested record: innermost layer.
  record nested-inner {
    label: string,
    score: f64,
    active: bool,
  }

  /// Deeply nested record: middle layer with inner record, list, option, variant.
  record nested-middle {
    inner: nested-inner,
    tags: list<string>,
    priority: option<u32>,
    shape: shape,
  }

  /// Deeply nested record: outermost input with all composite types nested.
  record complex-input {
    id: string,
    middle: nested-middle,
    color: color,
    metadata: option<list<u8>>,
  }

  /// Deeply nested record: detail inside output.
  record result-detail {
    code: u32,
    message: string,
    extra: option<string>,
  }

  /// Deeply nested record: complex output with nested record, list, option, variant, enum.
  record complex-output {
    success: bool,
    detail: result-detail,
    values: list<u32>,
    event: event-data,
    label: option<string>,
  }
}

/// Host-provided function that the guest can call.
interface host-ops {
  use types.{process-result, color, event-data, tagged-shape};
  get-value: func() -> u32;
  /// Takes a u64 param -- tests that canon lower produces i64 (not i32) in core ABI.
  get-random-len: func(len: u64) -> u64;
  /// Takes an enum param -- tests that canon lift correctly lifts enum args
  /// from guest memory when calling host imports.
  send-enum: func(c: color, msg: string) -> u32;
  /// Takes a record with option field -- tests that canon lift correctly
  /// handles option<list<u8>> inside a record parameter.
  send-event: func(event: event-data) -> u32;
  /// Returns an enum -- tests lowering path for enums from host to guest.
  get-color: func() -> color;
  /// Takes an option<u32> -- tests option lifting with correct slot consumption.
  check-option: func(val: option<u32>) -> u32;
  /// Returns a record -- tests retptr path for composite host import returns.
  get-event: func() -> event-data;
  /// Takes option<list<u8>> as standalone param -- tests nested type lifting.
  check-opt-bytes: func(data: option<list<u8>>) -> u32;
  /// Takes a record containing a variant -- tests nested variant in record lifting.
  send-tagged-shape: func(ts: tagged-shape) -> u32;
  /// Takes a list of records -- tests list<record> lifting.
  send-events: func(events: list<event-data>) -> u32;
}

/// Separate RNG interface mirroring director's host-rng.
interface host-rng {
  get-random-bytes: func(count: u32) -> list<u8>;
}

/// Guest-exported handler interface.
interface handler {
  use types.{process-result, color, permissions, shape, event-data, tagged-shape, complex-input, complex-output, nested-inner, nested-middle, result-detail};
  process: func() -> process-result;
  process-random: func(len: u64) -> u64;
  process-random-bytes: func(count: u32) -> list<u8>;
  echo-string: func(input: string) -> string;

  /// Calls host-ops.send-enum -- tests enum param lifting in host imports.
  call-send-enum: func(c: color, msg: string) -> u32;
  /// Calls host-ops.send-event -- tests record-with-option param lifting.
  call-send-event: func(event: event-data) -> u32;

  /// Primitive echo functions
  echo-bool: func(input: bool) -> bool;
  echo-s8: func(input: s8) -> s8;
  echo-u8: func(input: u8) -> u8;
  echo-s16: func(input: s16) -> s16;
  echo-u16: func(input: u16) -> u16;
  echo-f32: func(input: f32) -> f32;
  echo-f64: func(input: f64) -> f64;
  echo-char: func(input: char) -> char;

  /// Composite type echo functions
  echo-enum: func(input: color) -> color;
  echo-flags: func(input: permissions) -> permissions;
  echo-variant: func(input: shape) -> shape;

  /// Result type functions
  make-ok: func(value: u32) -> result<u32, string>;
  make-err: func(message: string) -> result<u32, string>;

  /// Multi-parameter functions
  add-three: func(a: u32, b: u32, c: u32) -> u32;
  concat-strings: func(a: string, b: string) -> string;
  mixed-params: func(name: string, count: u32, flag: bool) -> string;

  /// Host import test wrappers
  call-get-color: func() -> color;
  call-check-option: func(val: option<u32>) -> u32;
  call-get-event: func() -> event-data;
  call-check-opt-bytes: func(data: option<list<u8>>) -> u32;
  /// Calls host-ops.send-tagged-shape -- tests record-with-variant param lifting.
  call-send-tagged-shape: func(ts: tagged-shape) -> u32;
  /// Calls host-ops.send-events -- tests list<record> param lifting.
  call-send-events: func(events: list<event-data>) -> u32;

  /// Single string param + record return: isolates record-return-from-export with a param.
  process-with-tag: func(tag: string) -> process-result;
  /// Two string params + record return: tests multi-param record return without list types.
  process-two-strings: func(a: string, b: string) -> process-result;
  /// String + list<u8> returning u32: isolates list param lowering without record return.
  count-bytes: func(id: string, data: list<u8>) -> u32;
  /// Multi-param + record-return: mirrors director's handle-input(correlation-id, input) -> handle-result.
  handle-bytes: func(id: string, data: list<u8>) -> process-result;
  /// Multi-param + record-with-option param: mirrors director's handle-session-event(correlation-id, event) -> handle-result.
  handle-event: func(id: string, event: event-data) -> process-result;

  /// Multi-param with deeply nested complex record input.
  process-complex: func(id: string, count: u32, input: complex-input) -> u32;
  /// Multi-param with string + u32, returning deeply nested complex record output.
  transform-complex: func(name: string, code: u32) -> complex-output;
  /// Multi-param with string + variant, returning deeply nested complex record output.
  transform-complex-variant: func(name: string, shape: shape) -> complex-output;
}

world test-plugin {
  import host-ops;
  import host-rng;
  export handler;
}
