package test:variantlog;

interface types {
    enum severity {
        info,
        warning,
        error,
    }

    variant log-entry {
        message(string),
        code(u32),
        level(severity),
    }

    record log-result {
        count: u32,
        last-severity: severity,
    }
}

interface host-logger {
    use types.{severity};
    get-default-severity: func() -> severity;
}

interface processor {
    use types.{log-entry, log-result, severity};
    process-entry: func(entry: log-entry) -> log-result;
}

world variant-plugin {
    import host-logger;
    export processor;
}
